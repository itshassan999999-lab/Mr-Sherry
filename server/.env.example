# Copy this file to .env and adjust. Lines starting with # are ignored.

# How replies are generated:
#   gemini,groq : free. Gemini first (best quality of the free options), Groq when Gemini's
#                 free limit is reached. Default when GEMINI_API_KEY or GROQ_API_KEY is set.
#                 A provider in the list without a key is skipped.
#   gemini      : Google Gemini free tier (https://aistudio.google.com/apikey). Set GEMINI_API_KEY.
#   groq        : Groq free tier (https://console.groq.com). Set GROQ_API_KEY.
#   ollama      : a model running on this computer (ollama serve). No key.
#   claude-code : your logged-in Claude Code (Claude Pro/Max plan), no API key. Default without a key.
#   api         : Anthropic API key, pay per use. Best for a shared, hosted server.
#   manual      : no AI call; the panel gives you a prompt to paste into claude.ai.
# PROVIDER=gemini,groq
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# GEMINI_MODEL=gemini-2.5-flash     # per-provider model overrides (also GROQ_MODEL, OLLAMA_MODEL)
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=                        # model override when PROVIDER names a single provider
# LLM_BASE_URL=                     # override the endpoint (e.g. Ollama on another machine)
# PROVIDER=claude-code
# CLAUDE_CLI_MODEL=sonnet          # claude-code only; empty = your Claude Code default

# PROVIDER=api
# ANTHROPIC_API_KEY=sk-ant-...      # never put this in the extension
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium              # low = faster and cheaper, high = more careful

# Where the knowledge base is (playbook.md, topics/, chat-index.csv, optional official-docs/).
# Default: ../knowledge next to this repo's root, or the project layout.
# KB_DIR=../knowledge

# Server
# PORT=8787
# HOST=127.0.0.1                    # anything else requires ACCESS_TOKEN
# ACCESS_TOKEN=a-long-random-string # agents enter it once in the extension's Settings

# Usage and grounding tuning
# MAX_GUIDE_SECTIONS=6              # guide sections sent per request
# MAX_PAST_TICKETS=5
# MAX_CHAT_CHARS=24000              # longer chats drop their oldest messages
# MIN_GUIDE_SCORE=12                # below this: "not sure, escalate" without calling the AI
# MIN_TICKET_SCORE=25
# RATE_LIMIT_PER_MINUTE=20
