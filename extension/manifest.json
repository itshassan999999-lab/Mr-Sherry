{
  "manifest_version": 3,
  "name": "Support Reply Assistant",
  "version": "1.1.0",
  "description": "Reads the open client conversation and drafts a sourced reply for the agent to review. It never sends anything.",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://app.modalsupport.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reply Assistant",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
